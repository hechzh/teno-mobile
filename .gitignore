# Track only native source, build configuration, tests and project documentation.
*
!/.gitignore
!/.gitattributes
!/build.gradle
!/settings.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/README.md
!/README-0.2.1-history.md
!/RELEASE-0.3.0.txt
!/RELEASE-0.4.0.txt
!/VERSIONING.txt
!/VENDOR-JWD.md
!/JWD-测试指南.txt
!/LUCIDE-LICENSE.txt
!/THIRD-PARTY-NOTICES.txt
!/app/
!/app/build.gradle
!/app/src/
!/app/src/**
!/gradle/
!/gradle/**
!/tests/
!/tests/**
!/verification/
!/verification/v0.3.0/
!/verification/v0.3.0/package_release.py
!/verification/v0.4.0/
!/verification/v0.4.0/package_release.py

# Private configuration and generated material never enter source control.
**/[Aa][Gg][Ee][Nn][Tt][Ss].[Mm][Dd]
**/.env
**/.env.*
**/local.properties
**/*signing*.properties
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*credentials*
**/*accounts*.json
**/test-secrets.json
**/.gradle/
**/build/
**/dist/
**/__pycache__/
**/*.pyc
**/*.log
**/*-log.txt
**/*.apk
**/*.xapk
**/*.zip
**/*.wav
**/*.m4a
**/*.mp3
**/*.mp4
**/*.sqlite*
**/*.db
