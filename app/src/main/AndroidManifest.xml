    <application android:label="Teno" android:theme="@style/AppTheme" android:icon="@drawable/ic_app" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true" android:networkSecurityConfig="@xml/network_security_config">
